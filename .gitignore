# Node / npm workspaces
node_modules/
npm-debug.log*

# Build output
dist/
dist-webview/
out/
*.vsix

# Copied from the repo root at build time (apps/vscode-ext/scripts/copy-package-docs.js)
apps/vscode-ext/LICENSE
apps/vscode-ext/CHANGELOG.md
apps/vscode-ext/THIRD-PARTY-NOTICES.md

# @vscode/test-electron's downloaded VS Code binary + test user profile
.vscode-test/

# apps/web's predev/prebuild-copied MapLibre worker, and the tests-only engine
# mirror (apps/web/scripts/copy-wasm-assets.js). The engine itself is not
# bundled (spec 008 research §15); duckdb/ and sqljs/ are old build leftovers.
apps/web/public/duckdb/
apps/web/public/maplibre/
apps/web/public/sqljs/
apps/web/public/engine-mirror/

# Playwright test output + scripts/screenshots.mjs output
screenshots/
test-results/
playwright-report/

# Env
.env
.env.*

# Editor / OS
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# Logs
*.log

# Spec 007: generated multi-GB test files (scripts/large-data.sql)
tests/.large-data/
scripts/.crs-candidates.json
scripts/.engine-cache/

# brag launch video and its plugin settings (local only)
brag-output/
.claude/settings.json
