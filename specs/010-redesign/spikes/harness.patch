index 0000000..8892031
--- /dev/null
+++ b/packages/ui/src/spike010.ts
@@ -0,0 +1,85 @@
+// SPIKE (spec 010 phase 2, S1/S2), temporary: draws one engine-built MVT tile in a
+// separate MapLibre map through a custom protocol, with promoteId and feature-state.
+import { addProtocol, Map as MapLibreMap } from 'maplibre-gl'
+
+let tileBytes: Uint8Array | null = null
+let calls = 0
+let registered = false
+
+export interface TileRenderCheck {
+  calls: number
+  rendered: number
+  ids: Array<string | number | undefined>
+  selectedState: unknown
+  props: Record<string, unknown> | null
+  error: string | null
+}
+
+export async function renderTileCheck(bytes: Uint8Array, z: number, x: number, y: number, selectId: number): Promise<TileRenderCheck> {
+  tileBytes = bytes
+  calls = 0
+  if (!registered) {
+    registered = true
+    addProtocol('spk010', async () => {
+      calls++
+      const b = tileBytes ?? new Uint8Array(0)
+      return { data: b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength) as ArrayBuffer }
+    })
+  }
+  const div = document.createElement('div')
+  div.style.cssText = 'position:fixed;left:0;top:0;width:512px;height:512px;z-index:9999'
+  document.body.appendChild(div)
+  // Center of tile z/x/y.
+  const n = 2 ** z
+  const lon = ((x + 0.5) / n) * 360 - 180
+  const lat = (Math.atan(Math.sinh(Math.PI * (1 - (2 * (y + 0.5)) / n))) * 180) / Math.PI
+  let error: string | null = null
+  const map = new MapLibreMap({
+    container: div,
+    center: [lon, lat],
+    zoom: z,
+    attributionControl: false,
+    style: {
+      version: 8,
+      sources: { t: { type: 'vector', tiles: ['spk010://{z}/{x}/{y}'], minzoom: z, maxzoom: z, promoteId: { data: '__id' } } },
+      layers: [
+        { id: 'bg', type: 'background', paint: { 'background-color': '#fff' } },
+        { id: 'f', type: 'fill', source: 't', 'source-layer': 'data', paint: { 'fill-color': ['case', ['boolean', ['feature-state', 'selected'], false], '#f00', '#00f'] } },
+      ],
+    },
+  })
+  map.on('error', (e: { error?: { message?: string } }) => {
+    error = String(e.error?.message ?? e)
+  })
+  await new Promise<void>((resolve) => {
+    const t = setTimeout(resolve, 15000)
+    map.once('idle', () => {
+      clearTimeout(t)
+      resolve()
+    })
+  })
+  map.setFeatureState({ source: 't', sourceLayer: 'data', id: selectId }, { selected: true })
+  await new Promise<void>((resolve) => {
+    map.once('idle', () => resolve())
+    map.triggerRepaint()
+  })
+  const feats = map.queryRenderedFeatures({ layers: ['f'] })
+  const state = map.getFeatureState({ source: 't', sourceLayer: 'data', id: selectId })
+  const out = { calls, rendered: feats.length, ids: [...new Set(feats.map((f) => f.id))].slice(0, 20), selectedState: state, props: (feats[0]?.properties as Record<string, unknown> | undefined) ?? null, error }
+  map.remove()
+  div.remove()
+  return out
+}
+
+// S3: a stub data protocol that counts its calls.
+const stubCalls = new Map<string, number>()
+export function addStubProtocol(name: string, bytes: Uint8Array): void {
+  stubCalls.set(name, 0)
+  addProtocol(name, async () => {
+    stubCalls.set(name, (stubCalls.get(name) ?? 0) + 1)
+    return { data: bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) as ArrayBuffer }
+  })
+}
+export function stubProtocolCalls(name: string): number {
+  return stubCalls.get(name) ?? 0
+}
