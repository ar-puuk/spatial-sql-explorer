{
  "name": "spatial-explorer",
  "displayName": "Spatial Explorer: Spatial SQL & Map Viewer",
  "description": "Open a geospatial file and see it on a map and in a table, without opening a desktop GIS.",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "publisher": "arpuuk",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0e171e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ar-puuk/spatial-sql-explorer"
  },
  "homepage": "https://github.com/ar-puuk/spatial-sql-explorer",
  "bugs": {
    "url": "https://github.com/ar-puuk/spatial-sql-explorer/issues"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "gis",
    "geospatial",
    "geojson",
    "geoparquet",
    "spatial sql"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Spatial Explorer",
      "properties": {
        "spatialExplorer.placeSearch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer place results in the map's search box. A place search sends only the typed text to OpenStreetMap Nominatim, and only when you ask for it. Off: the box searches the layer and coordinates only."
        },
        "spatialExplorer.gdb.cacheLimitMB": {
          "type": "number",
          "default": 2048,
          "minimum": 256,
          "description": "The most disk space (in MB) the converted layers of File Geodatabases may use. The least recently used geodatabases are removed first."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "spatialExplorer.editor",
        "displayName": "Spatial Explorer",
        "selector": [
          {
            "filenamePattern": "*.gpkg"
          },
          {
            "filenamePattern": "*.fgb"
          },
          {
            "filenamePattern": "*.flatgeobuf"
          },
          {
            "filenamePattern": "*.shp"
          },
          {
            "filenamePattern": "*.geoparquet"
          },
          {
            "filenamePattern": "*.pmtiles"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "spatialExplorer.editorOption",
        "displayName": "Spatial Explorer",
        "selector": [
          {
            "filenamePattern": "*.geojson"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.gml"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.gdbtable"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "spatialExplorer.openInViewer",
        "title": "Open in Spatial Explorer",
        "category": "Spatial Explorer",
        "icon": "$(globe)"
      },
      {
        "command": "spatialExplorer.loadAll",
        "title": "Load All Features",
        "category": "Spatial Explorer"
      },
      {
        "command": "spatialExplorer.exportData",
        "title": "Export Data…",
        "category": "Spatial Explorer",
        "icon": "$(export)"
      },
      {
        "command": "spatialExplorer.openSample",
        "title": "Open Sample Data (US Counties)",
        "category": "Spatial Explorer",
        "icon": "$(map)"
      },
      {
        "command": "spatialExplorer.clearGdbCache",
        "title": "Clear Geodatabase Cache",
        "category": "Spatial Explorer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spatialExplorer.openInViewer",
          "when": "resourceExtname =~ /^\\.(gpkg|fgb|flatgeobuf|shp|geoparquet|pmtiles|geojson|json|csv|xlsx|parquet|gml|sqlite|db|zip)$/i && !explorerResourceIsFolder",
          "group": "navigation@20"
        },
        {
          "command": "spatialExplorer.openInViewer",
          "when": "explorerResourceIsFolder && resourceExtname == .gdb",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "spatialExplorer.openInViewer",
          "when": "resourceExtname =~ /^\\.(gpkg|fgb|flatgeobuf|shp|geoparquet|pmtiles|geojson|json|csv|xlsx|parquet|gml|sqlite|db|zip)$/i",
          "group": "1_open@20"
        }
      ],
      "editor/title": [
        {
          "command": "spatialExplorer.openInViewer",
          "when": "resourceExtname =~ /^\\.(gpkg|fgb|flatgeobuf|shp|geoparquet|pmtiles|geojson|json|csv|xlsx|parquet|gml|sqlite|db|zip)$/i && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "spatialExplorer.openInViewer",
          "when": "resourceExtname =~ /^\\.(gpkg|fgb|flatgeobuf|shp|geoparquet|pmtiles|geojson|json|csv|xlsx|parquet|gml|sqlite|db|zip)$/i"
        },
        {
          "command": "spatialExplorer.exportData",
          "when": "activeCustomEditorId == spatialExplorer.editor || activeCustomEditorId == spatialExplorer.editorOption"
        },
        {
          "command": "spatialExplorer.loadAll",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config vite.webview.config.ts && node scripts/copy-duckdb-wasm.js",
    "build": "node scripts/copy-package-docs.js && npm run build:extension && npm run build:webview",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.webview.json"
  },
  "dependencies": {
    "@spatial-explorer/core": "*",
    "@spatial-explorer/ui": "*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
